<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.commerce.mapper.ShopUserMapper">

    <resultMap type="ShopUser" id="ShopUserResult">
        <id property="id" column="id"/>
        <result property="shopId" column="shop_id"/>
        <result property="userId" column="user_id"/>
        <result property="shopRole" column="shop_role"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectShopIdByUserId" parameterType="Long" resultType="Long">
        select shop_id from shop_user
        where user_id = #{userId} and status = 'ACTIVE'
        order by id limit 1
    </select>

    <select id="selectByShopId" parameterType="Long" resultMap="ShopUserResult">
        select id, shop_id, user_id, shop_role, status, create_time
        from shop_user where shop_id = #{shopId} order by id
    </select>

    <insert id="insert" parameterType="ShopUser" useGeneratedKeys="true" keyProperty="id">
        insert into shop_user (shop_id, user_id, shop_role, status, create_time)
        values (#{shopId}, #{userId}, ifnull(#{shopRole}, 'OPERATOR'), ifnull(#{status}, 'ACTIVE'), sysdate())
    </insert>

    <delete id="delete" parameterType="Long">
        delete from shop_user where id = #{id}
    </delete>

</mapper>
