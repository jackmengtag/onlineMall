<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.commerce.mapper.ChannelConfigMapper">

    <resultMap type="ChannelConfig" id="ChannelConfigResult">
        <id property="channelConfigId" column="channel_config_id"/>
        <result property="channelCode" column="channel_code"/>
        <result property="channelName" column="channel_name"/>
        <result property="channelType" column="channel_type"/>
        <result property="countryCode" column="country_code"/>
        <result property="currencyCode" column="currency_code"/>
        <result property="endpoint" column="endpoint"/>
        <result property="appKey" column="app_key"/>
        <result property="status" column="status"/>
        <result property="lastSyncTime" column="last_sync_time"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectChannelVo">
        select channel_config_id, channel_code, channel_name, channel_type, country_code, currency_code,
               endpoint, app_key, status, last_sync_time, create_by, create_time, update_by, update_time, remark
        from channel_config
    </sql>

    <select id="selectList" parameterType="ChannelConfig" resultMap="ChannelConfigResult">
        <include refid="selectChannelVo"/>
        <where>
            <if test="channelCode != null and channelCode != ''">
                and channel_code like concat('%', #{channelCode}, '%')
            </if>
            <if test="channelName != null and channelName != ''">
                and channel_name like concat('%', #{channelName}, '%')
            </if>
            <if test="channelType != null and channelType != ''">and channel_type = #{channelType}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="countryCode != null and countryCode != ''">and country_code = #{countryCode}</if>
        </where>
        order by channel_config_id
    </select>

    <select id="selectById" parameterType="Long" resultMap="ChannelConfigResult">
        <include refid="selectChannelVo"/>
        where channel_config_id = #{channelConfigId}
    </select>

    <select id="selectByCode" parameterType="String" resultMap="ChannelConfigResult">
        <include refid="selectChannelVo"/>
        where channel_code = #{channelCode} limit 1
    </select>

    <insert id="insert" parameterType="ChannelConfig" useGeneratedKeys="true" keyProperty="channelConfigId">
        insert into channel_config (channel_code, channel_name, channel_type, country_code, currency_code,
                                    endpoint, app_key, status, last_sync_time, create_by, create_time, remark)
        values (#{channelCode}, #{channelName}, #{channelType}, #{countryCode}, #{currencyCode},
                #{endpoint}, #{appKey}, #{status}, #{lastSyncTime}, #{createBy}, sysdate(), #{remark})
    </insert>

    <update id="update" parameterType="ChannelConfig">
        update channel_config
        <set>
            <if test="channelCode != null and channelCode != ''">channel_code = #{channelCode},</if>
            <if test="channelName != null and channelName != ''">channel_name = #{channelName},</if>
            <if test="channelType != null and channelType != ''">channel_type = #{channelType},</if>
            <if test="countryCode != null">country_code = #{countryCode},</if>
            <if test="currencyCode != null and currencyCode != ''">currency_code = #{currencyCode},</if>
            <if test="endpoint != null">endpoint = #{endpoint},</if>
            <if test="appKey != null">app_key = #{appKey},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="lastSyncTime != null">last_sync_time = #{lastSyncTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where channel_config_id = #{channelConfigId}
    </update>

    <delete id="deleteByIds" parameterType="Long">
        delete from channel_config where channel_config_id in
        <foreach collection="array" item="channelConfigId" open="(" separator="," close=")">
            #{channelConfigId}
        </foreach>
    </delete>

</mapper>
