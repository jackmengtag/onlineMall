<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.commerce.mapper.ProductSkuMapper">

    <resultMap type="ProductSku" id="ProductSkuResult">
        <id     property="skuId"                column="sku_id"                 />
        <result property="spuId"                column="spu_id"                 />
        <result property="skuCode"              column="sku_code"               />
        <result property="barcode"              column="barcode"                />
        <result property="attributesJson"       column="attributes_json"        />
        <result property="weightGrams"          column="weight_grams"           />
        <result property="lengthMm"             column="length_mm"              />
        <result property="widthMm"              column="width_mm"               />
        <result property="heightMm"             column="height_mm"              />
        <result property="originCountryCode"    column="origin_country_code"    />
        <result property="hsCode"               column="hs_code"                />
        <result property="material"             column="material"               />
        <result property="batteryType"          column="battery_type"           />
        <result property="dangerousGoodsFlag"   column="dangerous_goods_flag"   />
        <result property="declaredName"         column="declared_name"          />
        <result property="declaredValueAmount"  column="declared_value_amount"  />
        <result property="declaredCurrencyCode" column="declared_currency_code" />
        <result property="status"               column="status"                 />
        <result property="createBy"             column="create_by"              />
        <result property="createTime"           column="create_time"            />
        <result property="updateBy"             column="update_by"              />
        <result property="updateTime"           column="update_time"            />
        <result property="remark"               column="remark"                 />
        <result property="spuName"              column="spu_name"               />
    </resultMap>

    <sql id="selectProductSkuVo">
        select k.sku_id, k.spu_id, k.sku_code, k.barcode, k.attributes_json, k.weight_grams, k.length_mm,
               k.width_mm, k.height_mm, k.origin_country_code, k.hs_code, k.material, k.battery_type,
               k.dangerous_goods_flag, k.declared_name, k.declared_value_amount, k.declared_currency_code,
               k.status, k.create_by, k.create_time, k.update_by, k.update_time, k.remark,
               s.default_name as spu_name
        from product_sku k
        left join product_spu s on s.spu_id = k.spu_id
    </sql>

    <select id="selectProductSkuById" parameterType="Long" resultMap="ProductSkuResult">
        <include refid="selectProductSkuVo"/>
        where k.sku_id = #{skuId}
    </select>

    <select id="selectProductSkuByCode" parameterType="String" resultMap="ProductSkuResult">
        <include refid="selectProductSkuVo"/>
        where k.sku_code = #{skuCode} limit 1
    </select>

    <select id="selectProductSkuList" parameterType="ProductSku" resultMap="ProductSkuResult">
        <include refid="selectProductSkuVo"/>
        <where>
            <if test="skuId != null">and k.sku_id = #{skuId}</if>
            <if test="spuId != null">and k.spu_id = #{spuId}</if>
            <if test="skuCode != null and skuCode != ''">and k.sku_code like concat('%', #{skuCode}, '%')</if>
            <if test="barcode != null and barcode != ''">and k.barcode = #{barcode}</if>
            <if test="originCountryCode != null and originCountryCode != ''">and k.origin_country_code = #{originCountryCode}</if>
            <if test="hsCode != null and hsCode != ''">and k.hs_code = #{hsCode}</if>
            <if test="status != null and status != ''">and k.status = #{status}</if>
        </where>
        order by k.sku_id desc
    </select>

    <select id="selectProductSkuBySpuId" parameterType="Long" resultMap="ProductSkuResult">
        <include refid="selectProductSkuVo"/>
        where k.spu_id = #{spuId}
        order by k.sku_id asc
    </select>

    <select id="countAvailableQty" resultType="int">
        select ifnull(sum(total_qty - locked_qty), 0)
        from inventory
        where sku_id = #{skuId}
        <if test="countryCode != null and countryCode != ''">and country_code = #{countryCode}</if>
    </select>

    <insert id="insertProductSku" parameterType="ProductSku" useGeneratedKeys="true" keyProperty="skuId">
        insert into product_sku (
            spu_id,
            sku_code,
            <if test="barcode != null">barcode,</if>
            <if test="attributesJson != null and attributesJson != ''">attributes_json,</if>
            <if test="weightGrams != null">weight_grams,</if>
            <if test="lengthMm != null">length_mm,</if>
            <if test="widthMm != null">width_mm,</if>
            <if test="heightMm != null">height_mm,</if>
            <if test="originCountryCode != null">origin_country_code,</if>
            <if test="hsCode != null">hs_code,</if>
            <if test="material != null">material,</if>
            <if test="batteryType != null">battery_type,</if>
            <if test="dangerousGoodsFlag != null">dangerous_goods_flag,</if>
            <if test="declaredName != null">declared_name,</if>
            <if test="declaredValueAmount != null">declared_value_amount,</if>
            <if test="declaredCurrencyCode != null">declared_currency_code,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        ) values (
            #{spuId},
            #{skuCode},
            <if test="barcode != null">#{barcode},</if>
            <if test="attributesJson != null and attributesJson != ''">#{attributesJson},</if>
            <if test="weightGrams != null">#{weightGrams},</if>
            <if test="lengthMm != null">#{lengthMm},</if>
            <if test="widthMm != null">#{widthMm},</if>
            <if test="heightMm != null">#{heightMm},</if>
            <if test="originCountryCode != null">#{originCountryCode},</if>
            <if test="hsCode != null">#{hsCode},</if>
            <if test="material != null">#{material},</if>
            <if test="batteryType != null">#{batteryType},</if>
            <if test="dangerousGoodsFlag != null">#{dangerousGoodsFlag},</if>
            <if test="declaredName != null">#{declaredName},</if>
            <if test="declaredValueAmount != null">#{declaredValueAmount},</if>
            <if test="declaredCurrencyCode != null">#{declaredCurrencyCode},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateProductSku" parameterType="ProductSku">
        update product_sku
        <set>
            <if test="spuId != null">spu_id = #{spuId},</if>
            <if test="skuCode != null and skuCode != ''">sku_code = #{skuCode},</if>
            <if test="barcode != null">barcode = #{barcode},</if>
            <if test="attributesJson != null and attributesJson != ''">attributes_json = #{attributesJson},</if>
            <if test="weightGrams != null">weight_grams = #{weightGrams},</if>
            <if test="lengthMm != null">length_mm = #{lengthMm},</if>
            <if test="widthMm != null">width_mm = #{widthMm},</if>
            <if test="heightMm != null">height_mm = #{heightMm},</if>
            <if test="originCountryCode != null">origin_country_code = #{originCountryCode},</if>
            <if test="hsCode != null">hs_code = #{hsCode},</if>
            <if test="material != null">material = #{material},</if>
            <if test="batteryType != null">battery_type = #{batteryType},</if>
            <if test="dangerousGoodsFlag != null">dangerous_goods_flag = #{dangerousGoodsFlag},</if>
            <if test="declaredName != null">declared_name = #{declaredName},</if>
            <if test="declaredValueAmount != null">declared_value_amount = #{declaredValueAmount},</if>
            <if test="declaredCurrencyCode != null">declared_currency_code = #{declaredCurrencyCode},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where sku_id = #{skuId}
    </update>

    <delete id="deleteProductSkuById" parameterType="Long">
        delete from product_sku where sku_id = #{skuId}
    </delete>

    <delete id="deleteProductSkuByIds" parameterType="Long">
        delete from product_sku where sku_id in
        <foreach item="skuId" collection="array" open="(" separator="," close=")">
            #{skuId}
        </foreach>
    </delete>

    <delete id="deleteSkuBySpuId" parameterType="Long">
        delete from product_sku where spu_id = #{spuId}
    </delete>

</mapper>
