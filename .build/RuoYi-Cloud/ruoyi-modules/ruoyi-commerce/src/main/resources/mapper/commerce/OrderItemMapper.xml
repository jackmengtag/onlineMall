<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.commerce.mapper.OrderItemMapper">

    <resultMap type="OrderItem" id="OrderItemResult">
        <id     property="orderItemId"    column="order_item_id"    />
        <result property="orderId"        column="order_id"         />
        <result property="skuId"          column="sku_id"           />
        <result property="skuCode"        column="sku_code"         />
        <result property="quantity"       column="quantity"         />
        <result property="unitPriceAmount" column="unit_price_amount" />
        <result property="discountAmount" column="discount_amount"  />
        <result property="taxAmount"      column="tax_amount"       />
        <result property="lineTotalAmount" column="line_total_amount" />
        <result property="currencyCode"   column="currency_code"    />
        <result property="createdAt"      column="created_at"       />
    </resultMap>

    <sql id="selectOrderItemVo">
        select order_item_id, order_id, sku_id, sku_code, quantity, unit_price_amount,
               discount_amount, tax_amount, line_total_amount, currency_code, created_at
        from order_items
    </sql>

    <select id="selectOrderItemsByOrderId" parameterType="Long" resultMap="OrderItemResult">
        <include refid="selectOrderItemVo"/>
        where order_id = #{orderId}
        order by order_item_id asc
    </select>

    <insert id="insertOrderItem" parameterType="OrderItem" useGeneratedKeys="true" keyProperty="orderItemId">
        insert into order_items (
            order_id,
            <if test="skuId != null">sku_id,</if>
            sku_code,
            quantity,
            unit_price_amount,
            <if test="discountAmount != null">discount_amount,</if>
            <if test="taxAmount != null">tax_amount,</if>
            line_total_amount,
            currency_code,
            created_at
        ) values (
            #{orderId},
            <if test="skuId != null">#{skuId},</if>
            #{skuCode},
            #{quantity},
            #{unitPriceAmount},
            <if test="discountAmount != null">#{discountAmount},</if>
            <if test="taxAmount != null">#{taxAmount},</if>
            #{lineTotalAmount},
            #{currencyCode},
            sysdate()
        )
    </insert>

    <insert id="insertOrderItemBatch" parameterType="java.util.List" useGeneratedKeys="true" keyProperty="orderItemId">
        insert into order_items (
            order_id, sku_id, sku_code, quantity, unit_price_amount,
            discount_amount, tax_amount, line_total_amount, currency_code, created_at
        ) values
        <foreach item="item" collection="list" separator=",">
            (
            #{item.orderId},
            #{item.skuId},
            #{item.skuCode},
            #{item.quantity},
            #{item.unitPriceAmount},
            #{item.discountAmount},
            #{item.taxAmount},
            #{item.lineTotalAmount},
            #{item.currencyCode},
            sysdate()
            )
        </foreach>
    </insert>

    <delete id="deleteOrderItemsByOrderId" parameterType="Long">
        delete from order_items where order_id = #{orderId}
    </delete>

</mapper>
