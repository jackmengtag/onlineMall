<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.commerce.mapper.FulfillmentOrderMapper">

    <resultMap type="FulfillmentOrder" id="FulfillmentOrderResult">
        <id     property="fulfillmentId"     column="fulfillment_id"     />
        <result property="fulfillmentNo"     column="fulfillment_no"     />
        <result property="orderId"           column="order_id"           />
        <result property="warehouseCode"     column="warehouse_code"     />
        <result property="fulfillmentStatus" column="fulfillment_status" />
        <result property="allocationReason"  column="allocation_reason"  />
        <result property="estimatedShipAt"   column="estimated_ship_at"  />
        <result property="actualShipAt"      column="actual_ship_at"     />
        <result property="completedAt"       column="completed_at"       />
        <result property="createdAt"         column="created_at"         />
        <result property="updatedAt"         column="updated_at"         />
    </resultMap>

    <sql id="selectFulfillmentOrderVo">
        select fulfillment_id, fulfillment_no, order_id, warehouse_code, fulfillment_status,
               allocation_reason, estimated_ship_at, actual_ship_at, completed_at, created_at, updated_at
        from fulfillment_orders
    </sql>

    <select id="selectFulfillmentOrderById" parameterType="Long" resultMap="FulfillmentOrderResult">
        <include refid="selectFulfillmentOrderVo"/>
        where fulfillment_id = #{fulfillmentId}
    </select>

    <select id="selectFulfillmentOrderList" parameterType="FulfillmentOrder" resultMap="FulfillmentOrderResult">
        <include refid="selectFulfillmentOrderVo"/>
        <where>
            <if test="fulfillmentNo != null and fulfillmentNo != ''">and fulfillment_no like concat('%', #{fulfillmentNo}, '%')</if>
            <if test="orderId != null">and order_id = #{orderId}</if>
            <if test="warehouseCode != null and warehouseCode != ''">and warehouse_code = #{warehouseCode}</if>
            <if test="fulfillmentStatus != null and fulfillmentStatus != ''">and fulfillment_status = #{fulfillmentStatus}</if>
        </where>
        order by fulfillment_id desc
    </select>

    <select id="selectByOrderId" parameterType="Long" resultMap="FulfillmentOrderResult">
        <include refid="selectFulfillmentOrderVo"/>
        where order_id = #{orderId}
        order by fulfillment_id asc
    </select>

    <insert id="insertFulfillmentOrder" parameterType="FulfillmentOrder" useGeneratedKeys="true" keyProperty="fulfillmentId">
        insert into fulfillment_orders (
            fulfillment_no,
            order_id,
            warehouse_code,
            <if test="fulfillmentStatus != null and fulfillmentStatus != ''">fulfillment_status,</if>
            <if test="allocationReason != null">allocation_reason,</if>
            <if test="estimatedShipAt != null">estimated_ship_at,</if>
            <if test="actualShipAt != null">actual_ship_at,</if>
            <if test="completedAt != null">completed_at,</if>
            created_at
        ) values (
            #{fulfillmentNo},
            #{orderId},
            #{warehouseCode},
            <if test="fulfillmentStatus != null and fulfillmentStatus != ''">#{fulfillmentStatus},</if>
            <if test="allocationReason != null">#{allocationReason},</if>
            <if test="estimatedShipAt != null">#{estimatedShipAt},</if>
            <if test="actualShipAt != null">#{actualShipAt},</if>
            <if test="completedAt != null">#{completedAt},</if>
            sysdate()
        )
    </insert>

    <update id="updateFulfillmentOrder" parameterType="FulfillmentOrder">
        update fulfillment_orders
        <set>
            <if test="fulfillmentNo != null and fulfillmentNo != ''">fulfillment_no = #{fulfillmentNo},</if>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="warehouseCode != null and warehouseCode != ''">warehouse_code = #{warehouseCode},</if>
            <if test="fulfillmentStatus != null and fulfillmentStatus != ''">fulfillment_status = #{fulfillmentStatus},</if>
            <if test="allocationReason != null">allocation_reason = #{allocationReason},</if>
            <if test="estimatedShipAt != null">estimated_ship_at = #{estimatedShipAt},</if>
            <if test="actualShipAt != null">actual_ship_at = #{actualShipAt},</if>
            <if test="completedAt != null">completed_at = #{completedAt},</if>
            updated_at = sysdate()
        </set>
        where fulfillment_id = #{fulfillmentId}
    </update>

    <update id="updateFulfillmentOrderStatus">
        update fulfillment_orders
        <set>
            fulfillment_status = #{toStatus},
            <if test="actualShipAt != null">actual_ship_at = #{actualShipAt},</if>
            <if test="completedAt != null">completed_at = #{completedAt},</if>
            updated_at = sysdate()
        </set>
        where fulfillment_id = #{fulfillmentId}
    </update>

</mapper>
