<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.commerce.mapper.ChannelListingMapper">

    <resultMap type="ChannelListing" id="ChannelListingResult">
        <id     property="listingId"         column="listing_id"          />
        <result property="channelCode"       column="channel_code"        />
        <result property="externalProductId" column="external_product_id" />
        <result property="externalSkuId"     column="external_sku_id"     />
        <result property="skuId"             column="sku_id"              />
        <result property="listingStatus"     column="listing_status"      />
        <result property="payloadJson"       column="payload_json"        />
        <result property="createdAt"         column="created_at"          />
        <result property="updatedAt"         column="updated_at"          />
    </resultMap>

    <sql id="selectChannelListingVo">
        select listing_id, channel_code, external_product_id, external_sku_id, sku_id, listing_status,
               payload_json, created_at, updated_at
        from channel_listing
    </sql>

    <select id="selectChannelListingById" parameterType="Long" resultMap="ChannelListingResult">
        <include refid="selectChannelListingVo"/>
        where listing_id = #{listingId}
    </select>

    <select id="selectChannelListingByUnique" resultMap="ChannelListingResult">
        <include refid="selectChannelListingVo"/>
        where channel_code = #{channelCode}
          and external_product_id = #{externalProductId}
        <choose>
            <when test="externalSkuId != null and externalSkuId != ''">and external_sku_id = #{externalSkuId}</when>
            <otherwise>and (external_sku_id is null or external_sku_id = '')</otherwise>
        </choose>
        limit 1
    </select>

    <select id="selectByChannelAndExternalProduct" resultMap="ChannelListingResult">
        <include refid="selectChannelListingVo"/>
        where channel_code = #{channelCode}
          and external_product_id = #{externalProductId}
        order by listing_id desc
    </select>

    <select id="selectChannelListingList" parameterType="ChannelListing" resultMap="ChannelListingResult">
        <include refid="selectChannelListingVo"/>
        <where>
            <if test="channelCode != null and channelCode != ''">and channel_code = #{channelCode}</if>
            <if test="externalProductId != null and externalProductId != ''">and external_product_id = #{externalProductId}</if>
            <if test="externalSkuId != null and externalSkuId != ''">and external_sku_id = #{externalSkuId}</if>
            <if test="skuId != null">and sku_id = #{skuId}</if>
            <if test="listingStatus != null and listingStatus != ''">and listing_status = #{listingStatus}</if>
        </where>
        order by listing_id desc
    </select>

    <insert id="insertChannelListing" parameterType="ChannelListing" useGeneratedKeys="true" keyProperty="listingId">
        insert into channel_listing (
            channel_code,
            external_product_id,
            <if test="externalSkuId != null">external_sku_id,</if>
            <if test="skuId != null">sku_id,</if>
            <if test="listingStatus != null and listingStatus != ''">listing_status,</if>
            payload_json,
            created_at
        ) values (
            #{channelCode},
            #{externalProductId},
            <if test="externalSkuId != null">#{externalSkuId},</if>
            <if test="skuId != null">#{skuId},</if>
            <if test="listingStatus != null and listingStatus != ''">#{listingStatus},</if>
            #{payloadJson},
            sysdate()
        )
    </insert>

    <update id="updateChannelListing" parameterType="ChannelListing">
        update channel_listing
        <set>
            <if test="channelCode != null and channelCode != ''">channel_code = #{channelCode},</if>
            <if test="externalProductId != null and externalProductId != ''">external_product_id = #{externalProductId},</if>
            <if test="externalSkuId != null">external_sku_id = #{externalSkuId},</if>
            <if test="skuId != null">sku_id = #{skuId},</if>
            <if test="listingStatus != null and listingStatus != ''">listing_status = #{listingStatus},</if>
            <if test="payloadJson != null">payload_json = #{payloadJson},</if>
            updated_at = sysdate()
        </set>
        where listing_id = #{listingId}
    </update>

    <delete id="deleteChannelListingById" parameterType="Long">
        delete from channel_listing where listing_id = #{listingId}
    </delete>

    <delete id="deleteChannelListingByIds" parameterType="Long">
        delete from channel_listing where listing_id in
        <foreach item="listingId" collection="array" open="(" separator="," close=")">
            #{listingId}
        </foreach>
    </delete>

</mapper>
