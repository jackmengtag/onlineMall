<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.commerce.mapper.OrderItemSnapshotMapper">

    <resultMap type="OrderItemSnapshot" id="OrderItemSnapshotResult">
        <id     property="snapshotId"           column="snapshot_id"            />
        <result property="orderItemId"          column="order_item_id"          />
        <result property="productName"          column="product_name"           />
        <result property="skuCode"              column="sku_code"               />
        <result property="attributesJson"       column="attributes_json"        />
        <result property="imageUrl"             column="image_url"              />
        <result property="originCountryCode"    column="origin_country_code"    />
        <result property="hsCode"               column="hs_code"                />
        <result property="declaredName"         column="declared_name"          />
        <result property="declaredValueAmount"  column="declared_value_amount"  />
        <result property="declaredCurrencyCode" column="declared_currency_code" />
        <result property="unitPriceAmount"      column="unit_price_amount"      />
        <result property="currencyCode"         column="currency_code"          />
        <result property="createdAt"            column="created_at"             />
    </resultMap>

    <sql id="selectOrderItemSnapshotVo">
        select snapshot_id, order_item_id, product_name, sku_code, attributes_json, image_url,
               origin_country_code, hs_code, declared_name, declared_value_amount, declared_currency_code,
               unit_price_amount, currency_code, created_at
        from order_item_snapshots
    </sql>

    <select id="selectSnapshotByOrderItemId" parameterType="Long" resultMap="OrderItemSnapshotResult">
        <include refid="selectOrderItemSnapshotVo"/>
        where order_item_id = #{orderItemId} limit 1
    </select>

    <insert id="insertOrderItemSnapshot" parameterType="OrderItemSnapshot" useGeneratedKeys="true" keyProperty="snapshotId">
        insert into order_item_snapshots (
            order_item_id,
            <if test="productName != null">product_name,</if>
            <if test="skuCode != null">sku_code,</if>
            <if test="attributesJson != null">attributes_json,</if>
            <if test="imageUrl != null">image_url,</if>
            <if test="originCountryCode != null">origin_country_code,</if>
            <if test="hsCode != null">hs_code,</if>
            <if test="declaredName != null">declared_name,</if>
            <if test="declaredValueAmount != null">declared_value_amount,</if>
            <if test="declaredCurrencyCode != null">declared_currency_code,</if>
            <if test="unitPriceAmount != null">unit_price_amount,</if>
            <if test="currencyCode != null">currency_code,</if>
            created_at
        ) values (
            #{orderItemId},
            <if test="productName != null">#{productName},</if>
            <if test="skuCode != null">#{skuCode},</if>
            <if test="attributesJson != null">#{attributesJson},</if>
            <if test="imageUrl != null">#{imageUrl},</if>
            <if test="originCountryCode != null">#{originCountryCode},</if>
            <if test="hsCode != null">#{hsCode},</if>
            <if test="declaredName != null">#{declaredName},</if>
            <if test="declaredValueAmount != null">#{declaredValueAmount},</if>
            <if test="declaredCurrencyCode != null">#{declaredCurrencyCode},</if>
            <if test="unitPriceAmount != null">#{unitPriceAmount},</if>
            <if test="currencyCode != null">#{currencyCode},</if>
            sysdate()
        )
    </insert>

</mapper>
