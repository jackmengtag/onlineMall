<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.commerce.mapper.ProductSpuMapper">

    <resultMap type="ProductSpu" id="ProductSpuResult">
        <id     property="spuId"              column="spu_id"              />
        <result property="spuCode"            column="spu_code"            />
        <result property="brandId"            column="brand_id"            />
        <result property="categoryId"         column="category_id"         />
        <result property="defaultName"        column="default_name"        />
        <result property="defaultDescription" column="default_description" />
        <result property="status"             column="status"              />
        <result property="defaultImageUrl"    column="default_image_url"   />
        <result property="createdAt"          column="created_at"          />
        <result property="updatedAt"          column="updated_at"          />
    </resultMap>

    <sql id="selectProductSpuVo">
        select spu_id, spu_code, brand_id, category_id, default_name, default_description,
               status, default_image_url, created_at, updated_at
        from product_spu
    </sql>

    <select id="selectProductSpuById" parameterType="Long" resultMap="ProductSpuResult">
        <include refid="selectProductSpuVo"/>
        where spu_id = #{spuId}
    </select>

    <select id="selectProductSpuByCode" parameterType="String" resultMap="ProductSpuResult">
        <include refid="selectProductSpuVo"/>
        where spu_code = #{spuCode} limit 1
    </select>

    <select id="selectProductSpuList" parameterType="ProductSpu" resultMap="ProductSpuResult">
        <include refid="selectProductSpuVo"/>
        <where>
            <if test="spuCode != null and spuCode != ''">and spu_code like concat('%', #{spuCode}, '%')</if>
            <if test="defaultName != null and defaultName != ''">and default_name like concat('%', #{defaultName}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="brandId != null">and brand_id = #{brandId}</if>
            <if test="categoryId != null">and category_id = #{categoryId}</if>
        </where>
        order by spu_id desc
    </select>

    <insert id="insertProductSpu" parameterType="ProductSpu" useGeneratedKeys="true" keyProperty="spuId">
        insert into product_spu (
            spu_code,
            <if test="brandId != null">brand_id,</if>
            <if test="categoryId != null">category_id,</if>
            default_name,
            <if test="defaultDescription != null">default_description,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="defaultImageUrl != null">default_image_url,</if>
            created_at
        ) values (
            #{spuCode},
            <if test="brandId != null">#{brandId},</if>
            <if test="categoryId != null">#{categoryId},</if>
            #{defaultName},
            <if test="defaultDescription != null">#{defaultDescription},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="defaultImageUrl != null">#{defaultImageUrl},</if>
            sysdate()
        )
    </insert>

    <update id="updateProductSpu" parameterType="ProductSpu">
        update product_spu
        <set>
            <if test="spuCode != null and spuCode != ''">spu_code = #{spuCode},</if>
            <if test="brandId != null">brand_id = #{brandId},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="defaultName != null and defaultName != ''">default_name = #{defaultName},</if>
            <if test="defaultDescription != null">default_description = #{defaultDescription},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="defaultImageUrl != null">default_image_url = #{defaultImageUrl},</if>
            updated_at = sysdate()
        </set>
        where spu_id = #{spuId}
    </update>

    <delete id="deleteProductSpuById" parameterType="Long">
        delete from product_spu where spu_id = #{spuId}
    </delete>

    <delete id="deleteProductSpuByIds" parameterType="Long">
        delete from product_spu where spu_id in
        <foreach item="spuId" collection="array" open="(" separator="," close=")">
            #{spuId}
        </foreach>
    </delete>

</mapper>
