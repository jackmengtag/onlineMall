<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.commerce.mapper.ShipmentMapper">

    <resultMap type="Shipment" id="ShipmentResult">
        <id     property="shipmentId"     column="shipment_id"     />
        <result property="shipmentNo"     column="shipment_no"     />
        <result property="fulfillmentId"  column="fulfillment_id"  />
        <result property="carrierCode"    column="carrier_code"    />
        <result property="trackingNo"     column="tracking_no"     />
        <result property="shipmentStatus" column="shipment_status" />
        <result property="shippedAt"      column="shipped_at"      />
        <result property="deliveredAt"    column="delivered_at"    />
        <result property="createdAt"      column="created_at"      />
        <result property="updatedAt"      column="updated_at"      />
    </resultMap>

    <sql id="selectShipmentVo">
        select shipment_id, shipment_no, fulfillment_id, carrier_code, tracking_no, shipment_status,
               shipped_at, delivered_at, created_at, updated_at
        from shipments
    </sql>

    <select id="selectShipmentById" parameterType="Long" resultMap="ShipmentResult">
        <include refid="selectShipmentVo"/>
        where shipment_id = #{shipmentId}
    </select>

    <select id="selectShipmentList" parameterType="Shipment" resultMap="ShipmentResult">
        <include refid="selectShipmentVo"/>
        <where>
            <if test="shipmentNo != null and shipmentNo != ''">and shipment_no like concat('%', #{shipmentNo}, '%')</if>
            <if test="fulfillmentId != null">and fulfillment_id = #{fulfillmentId}</if>
            <if test="carrierCode != null and carrierCode != ''">and carrier_code = #{carrierCode}</if>
            <if test="trackingNo != null and trackingNo != ''">and tracking_no = #{trackingNo}</if>
            <if test="shipmentStatus != null and shipmentStatus != ''">and shipment_status = #{shipmentStatus}</if>
        </where>
        order by shipment_id desc
    </select>

    <select id="selectByFulfillmentId" parameterType="Long" resultMap="ShipmentResult">
        <include refid="selectShipmentVo"/>
        where fulfillment_id = #{fulfillmentId}
        order by shipment_id desc limit 1
    </select>

    <insert id="insertShipment" parameterType="Shipment" useGeneratedKeys="true" keyProperty="shipmentId">
        insert into shipments (
            shipment_no,
            fulfillment_id,
            carrier_code,
            <if test="trackingNo != null and trackingNo != ''">tracking_no,</if>
            <if test="shipmentStatus != null and shipmentStatus != ''">shipment_status,</if>
            <if test="shippedAt != null">shipped_at,</if>
            <if test="deliveredAt != null">delivered_at,</if>
            created_at
        ) values (
            #{shipmentNo},
            #{fulfillmentId},
            #{carrierCode},
            <if test="trackingNo != null and trackingNo != ''">#{trackingNo},</if>
            <if test="shipmentStatus != null and shipmentStatus != ''">#{shipmentStatus},</if>
            <if test="shippedAt != null">#{shippedAt},</if>
            <if test="deliveredAt != null">#{deliveredAt},</if>
            sysdate()
        )
    </insert>

    <update id="updateShipmentStatus">
        update shipments
        <set>
            shipment_status = #{status},
            <if test="deliveredAt != null">delivered_at = #{deliveredAt},</if>
            updated_at = sysdate()
        </set>
        where shipment_id = #{shipmentId}
    </update>

</mapper>
