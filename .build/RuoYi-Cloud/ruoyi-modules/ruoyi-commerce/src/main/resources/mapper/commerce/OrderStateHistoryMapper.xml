<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.commerce.mapper.OrderStateHistoryMapper">

    <resultMap type="OrderStateHistory" id="OrderStateHistoryResult">
        <id     property="historyId"    column="history_id"    />
        <result property="orderId"      column="order_id"      />
        <result property="fromStatus"   column="from_status"   />
        <result property="toStatus"     column="to_status"     />
        <result property="statusType"   column="status_type"   />
        <result property="reason"       column="reason"        />
        <result property="operatorType" column="operator_type" />
        <result property="operatorId"   column="operator_id"   />
        <result property="occurredAt"   column="occurred_at"   />
    </resultMap>

    <sql id="selectStateHistoryVo">
        select history_id, order_id, from_status, to_status, status_type, reason,
               operator_type, operator_id, occurred_at
        from order_state_histories
    </sql>

    <select id="selectStateHistoriesByOrderId" parameterType="Long" resultMap="OrderStateHistoryResult">
        <include refid="selectStateHistoryVo"/>
        where order_id = #{orderId}
        order by history_id asc
    </select>

    <insert id="insertOrderStateHistory" parameterType="OrderStateHistory" useGeneratedKeys="true" keyProperty="historyId">
        insert into order_state_histories (
            order_id,
            <if test="fromStatus != null">from_status,</if>
            to_status,
            status_type,
            <if test="reason != null">reason,</if>
            <if test="operatorType != null and operatorType != ''">operator_type,</if>
            <if test="operatorId != null">operator_id,</if>
            occurred_at
        ) values (
            #{orderId},
            <if test="fromStatus != null">#{fromStatus},</if>
            #{toStatus},
            #{statusType},
            <if test="reason != null">#{reason},</if>
            <if test="operatorType != null and operatorType != ''">#{operatorType},</if>
            <if test="operatorId != null">#{operatorId},</if>
            sysdate()
        )
    </insert>

</mapper>
