<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.commerce.mapper.LocalMessageMapper">

    <resultMap type="LocalMessage" id="LocalMessageResult">
        <id     property="messageId"    column="message_id"    />
        <result property="messageNo"    column="message_no"    />
        <result property="topic"        column="topic"         />
        <result property="bizKey"       column="biz_key"       />
        <result property="payloadJson"  column="payload_json"  />
        <result property="status"       column="status"        />
        <result property="retryCount"   column="retry_count"   />
        <result property="nextRetryAt"  column="next_retry_at" />
        <result property="sentAt"       column="sent_at"       />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
    </resultMap>

    <sql id="selectLocalMessageVo">
        select message_id, message_no, topic, biz_key, payload_json, status,
               retry_count, next_retry_at, sent_at, created_at, updated_at
        from local_message
    </sql>

    <select id="selectLocalMessageById" parameterType="Long" resultMap="LocalMessageResult">
        <include refid="selectLocalMessageVo"/>
        where message_id = #{messageId}
    </select>

    <select id="selectPendingMessages" parameterType="int" resultMap="LocalMessageResult">
        <include refid="selectLocalMessageVo"/>
        where status = 'PENDING'
          and (next_retry_at is null or next_retry_at &lt;= sysdate())
        order by message_id asc
        limit #{limit}
    </select>

    <select id="selectLocalMessageList" parameterType="LocalMessage" resultMap="LocalMessageResult">
        <include refid="selectLocalMessageVo"/>
        <where>
            <if test="topic != null and topic != ''">and topic = #{topic}</if>
            <if test="bizKey != null and bizKey != ''">and biz_key = #{bizKey}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by message_id desc
    </select>

    <insert id="insertLocalMessage" parameterType="LocalMessage" useGeneratedKeys="true" keyProperty="messageId">
        insert into local_message (
            message_no,
            topic,
            <if test="bizKey != null">biz_key,</if>
            <if test="payloadJson != null">payload_json,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="retryCount != null">retry_count,</if>
            <if test="nextRetryAt != null">next_retry_at,</if>
            created_at
        ) values (
            #{messageNo},
            #{topic},
            <if test="bizKey != null">#{bizKey},</if>
            <if test="payloadJson != null">#{payloadJson},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="retryCount != null">#{retryCount},</if>
            <if test="nextRetryAt != null">#{nextRetryAt},</if>
            sysdate()
        )
    </insert>

    <update id="updateLocalMessage" parameterType="LocalMessage">
        update local_message
        <set>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="retryCount != null">retry_count = #{retryCount},</if>
            <if test="nextRetryAt != null">next_retry_at = #{nextRetryAt},</if>
            <if test="sentAt != null">sent_at = #{sentAt},</if>
            updated_at = sysdate()
        </set>
        where message_id = #{messageId}
    </update>

</mapper>
