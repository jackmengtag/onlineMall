<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.commerce.mapper.PaymentEventMapper">

    <resultMap type="PaymentEvent" id="PaymentEventResult">
        <id     property="paymentEventId"  column="payment_event_id"  />
        <result property="paymentId"       column="payment_id"        />
        <result property="provider"        column="provider"          />
        <result property="providerEventId" column="provider_event_id" />
        <result property="eventType"       column="event_type"        />
        <result property="eventStatus"     column="event_status"      />
        <result property="payloadJson"     column="payload_json"      />
        <result property="receivedAt"      column="received_at"       />
        <result property="processedAt"     column="processed_at"      />
    </resultMap>

    <sql id="selectPaymentEventVo">
        select payment_event_id, payment_id, provider, provider_event_id, event_type,
               event_status, payload_json, received_at, processed_at
        from payment_events
    </sql>

    <select id="selectByProviderAndEventId" resultMap="PaymentEventResult">
        <include refid="selectPaymentEventVo"/>
        where provider = #{provider} and provider_event_id = #{providerEventId} limit 1
    </select>

    <select id="selectPaymentEvents" parameterType="Long" resultMap="PaymentEventResult">
        <include refid="selectPaymentEventVo"/>
        where payment_id = #{paymentId}
        order by payment_event_id desc
    </select>

    <insert id="insertPaymentEvent" parameterType="PaymentEvent" useGeneratedKeys="true" keyProperty="paymentEventId">
        insert into payment_events (
            payment_id,
            <if test="provider != null">provider,</if>
            <if test="providerEventId != null">provider_event_id,</if>
            <if test="eventType != null">event_type,</if>
            <if test="eventStatus != null">event_status,</if>
            <if test="payloadJson != null">payload_json,</if>
            received_at
        ) values (
            #{paymentId},
            <if test="provider != null">#{provider},</if>
            <if test="providerEventId != null">#{providerEventId},</if>
            <if test="eventType != null">#{eventType},</if>
            <if test="eventStatus != null">#{eventStatus},</if>
            <if test="payloadJson != null">#{payloadJson},</if>
            sysdate()
        )
    </insert>

    <update id="updatePaymentEvent" parameterType="PaymentEvent">
        update payment_events
        <set>
            <if test="eventStatus != null">event_status = #{eventStatus},</if>
            <if test="processedAt != null">processed_at = #{processedAt},</if>
        </set>
        where payment_event_id = #{paymentEventId}
    </update>

</mapper>
