<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.commerce.mapper.OrderSnapshotMapper">

    <resultMap type="OrderSnapshot" id="OrderSnapshotResult">
        <id     property="snapshotId"          column="snapshot_id"           />
        <result property="orderId"             column="order_id"              />
        <result property="buyerName"           column="buyer_name"            />
        <result property="buyerEmail"          column="buyer_email"           />
        <result property="recipientName"       column="recipient_name"        />
        <result property="recipientPhone"      column="recipient_phone"       />
        <result property="countryCode"         column="country_code"          />
        <result property="stateCode"           column="state_code"            />
        <result property="city"                column="city"                  />
        <result property="district"            column="district"              />
        <result property="addressLine1"        column="address_line1"         />
        <result property="addressLine2"        column="address_line2"         />
        <result property="postalCode"          column="postal_code"           />
        <result property="taxRuleVersion"      column="tax_rule_version"      />
        <result property="exchangeRateVersion" column="exchange_rate_version" />
        <result property="exchangeRate"        column="exchange_rate"         />
        <result property="rawAddressJson"      column="raw_address_json"      />
        <result property="createdAt"           column="created_at"            />
    </resultMap>

    <sql id="selectOrderSnapshotVo">
        select snapshot_id, order_id, buyer_name, buyer_email, recipient_name, recipient_phone,
               country_code, state_code, city, district, address_line1, address_line2, postal_code,
               tax_rule_version, exchange_rate_version, exchange_rate, raw_address_json, created_at
        from order_snapshots
    </sql>

    <select id="selectSnapshotByOrderId" parameterType="Long" resultMap="OrderSnapshotResult">
        <include refid="selectOrderSnapshotVo"/>
        where order_id = #{orderId} limit 1
    </select>

    <insert id="insertOrderSnapshot" parameterType="OrderSnapshot" useGeneratedKeys="true" keyProperty="snapshotId">
        insert into order_snapshots (
            order_id,
            <if test="buyerName != null">buyer_name,</if>
            <if test="buyerEmail != null">buyer_email,</if>
            <if test="recipientName != null">recipient_name,</if>
            <if test="recipientPhone != null">recipient_phone,</if>
            <if test="countryCode != null">country_code,</if>
            <if test="stateCode != null">state_code,</if>
            <if test="city != null">city,</if>
            <if test="district != null">district,</if>
            <if test="addressLine1 != null">address_line1,</if>
            <if test="addressLine2 != null">address_line2,</if>
            <if test="postalCode != null">postal_code,</if>
            <if test="taxRuleVersion != null">tax_rule_version,</if>
            <if test="exchangeRateVersion != null">exchange_rate_version,</if>
            <if test="exchangeRate != null">exchange_rate,</if>
            <if test="rawAddressJson != null">raw_address_json,</if>
            created_at
        ) values (
            #{orderId},
            <if test="buyerName != null">#{buyerName},</if>
            <if test="buyerEmail != null">#{buyerEmail},</if>
            <if test="recipientName != null">#{recipientName},</if>
            <if test="recipientPhone != null">#{recipientPhone},</if>
            <if test="countryCode != null">#{countryCode},</if>
            <if test="stateCode != null">#{stateCode},</if>
            <if test="city != null">#{city},</if>
            <if test="district != null">#{district},</if>
            <if test="addressLine1 != null">#{addressLine1},</if>
            <if test="addressLine2 != null">#{addressLine2},</if>
            <if test="postalCode != null">#{postalCode},</if>
            <if test="taxRuleVersion != null">#{taxRuleVersion},</if>
            <if test="exchangeRateVersion != null">#{exchangeRateVersion},</if>
            <if test="exchangeRate != null">#{exchangeRate},</if>
            <if test="rawAddressJson != null">#{rawAddressJson},</if>
            sysdate()
        )
    </insert>

</mapper>
