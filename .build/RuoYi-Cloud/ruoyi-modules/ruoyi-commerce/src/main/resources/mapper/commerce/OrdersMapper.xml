<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.commerce.mapper.OrdersMapper">

    <resultMap type="Orders" id="OrdersResult">
        <id     property="orderId"           column="order_id"           />
        <result property="orderNo"           column="order_no"           />
        <result property="customerId"        column="customer_id"        />
        <result property="channelCode"       column="channel_code"       />
        <result property="externalOrderId"   column="external_order_id"  />
        <result property="countryCode"       column="country_code"       />
        <result property="currencyCode"      column="currency_code"      />
        <result property="subtotalAmount"    column="subtotal_amount"    />
        <result property="discountAmount"    column="discount_amount"    />
        <result property="shippingAmount"    column="shipping_amount"    />
        <result property="taxAmount"         column="tax_amount"         />
        <result property="totalAmount"       column="total_amount"       />
        <result property="orderStatus"       column="order_status"       />
        <result property="paymentStatus"     column="payment_status"     />
        <result property="fulfillmentStatus" column="fulfillment_status" />
        <result property="afterSaleStatus"   column="after_sale_status"  />
        <result property="placedAt"          column="placed_at"          />
        <result property="paidAt"            column="paid_at"            />
        <result property="cancelledAt"       column="cancelled_at"       />
        <result property="completedAt"       column="completed_at"       />
        <result property="createdAt"         column="created_at"         />
        <result property="updatedAt"         column="updated_at"         />
    </resultMap>

    <sql id="selectOrdersVo">
        select order_id, order_no, customer_id, channel_code, external_order_id, country_code, currency_code,
               subtotal_amount, discount_amount, shipping_amount, tax_amount, total_amount,
               order_status, payment_status, fulfillment_status, after_sale_status,
               placed_at, paid_at, cancelled_at, completed_at, created_at, updated_at
        from orders
    </sql>

    <select id="selectOrdersById" parameterType="Long" resultMap="OrdersResult">
        <include refid="selectOrdersVo"/>
        where order_id = #{orderId}
    </select>

    <select id="selectOrdersByNo" parameterType="String" resultMap="OrdersResult">
        <include refid="selectOrdersVo"/>
        where order_no = #{orderNo} limit 1
    </select>

    <select id="selectOrdersList" parameterType="Orders" resultMap="OrdersResult">
        <include refid="selectOrdersVo"/>
        <where>
            <if test="orderNo != null and orderNo != ''">and order_no like concat('%', #{orderNo}, '%')</if>
            <if test="customerId != null">and customer_id = #{customerId}</if>
            <if test="channelCode != null and channelCode != ''">and channel_code = #{channelCode}</if>
            <if test="externalOrderId != null and externalOrderId != ''">and external_order_id = #{externalOrderId}</if>
            <if test="countryCode != null and countryCode != ''">and country_code = #{countryCode}</if>
            <if test="currencyCode != null and currencyCode != ''">and currency_code = #{currencyCode}</if>
            <if test="orderStatus != null and orderStatus != ''">and order_status = #{orderStatus}</if>
            <if test="paymentStatus != null and paymentStatus != ''">and payment_status = #{paymentStatus}</if>
            <if test="fulfillmentStatus != null and fulfillmentStatus != ''">and fulfillment_status = #{fulfillmentStatus}</if>
            <if test="afterSaleStatus != null and afterSaleStatus != ''">and after_sale_status = #{afterSaleStatus}</if>
        </where>
        order by order_id desc
    </select>

    <insert id="insertOrders" parameterType="Orders" useGeneratedKeys="true" keyProperty="orderId">
        insert into orders (
            order_no,
            <if test="customerId != null">customer_id,</if>
            <if test="channelCode != null and channelCode != ''">channel_code,</if>
            <if test="externalOrderId != null">external_order_id,</if>
            <if test="countryCode != null and countryCode != ''">country_code,</if>
            <if test="currencyCode != null and currencyCode != ''">currency_code,</if>
            <if test="subtotalAmount != null">subtotal_amount,</if>
            <if test="discountAmount != null">discount_amount,</if>
            <if test="shippingAmount != null">shipping_amount,</if>
            <if test="taxAmount != null">tax_amount,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="orderStatus != null and orderStatus != ''">order_status,</if>
            <if test="paymentStatus != null and paymentStatus != ''">payment_status,</if>
            <if test="fulfillmentStatus != null and fulfillmentStatus != ''">fulfillment_status,</if>
            <if test="afterSaleStatus != null and afterSaleStatus != ''">after_sale_status,</if>
            <if test="placedAt != null">placed_at,</if>
            <if test="paidAt != null">paid_at,</if>
            <if test="cancelledAt != null">cancelled_at,</if>
            <if test="completedAt != null">completed_at,</if>
            created_at
        ) values (
            #{orderNo},
            <if test="customerId != null">#{customerId},</if>
            <if test="channelCode != null and channelCode != ''">#{channelCode},</if>
            <if test="externalOrderId != null">#{externalOrderId},</if>
            <if test="countryCode != null and countryCode != ''">#{countryCode},</if>
            <if test="currencyCode != null and currencyCode != ''">#{currencyCode},</if>
            <if test="subtotalAmount != null">#{subtotalAmount},</if>
            <if test="discountAmount != null">#{discountAmount},</if>
            <if test="shippingAmount != null">#{shippingAmount},</if>
            <if test="taxAmount != null">#{taxAmount},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="orderStatus != null and orderStatus != ''">#{orderStatus},</if>
            <if test="paymentStatus != null and paymentStatus != ''">#{paymentStatus},</if>
            <if test="fulfillmentStatus != null and fulfillmentStatus != ''">#{fulfillmentStatus},</if>
            <if test="afterSaleStatus != null and afterSaleStatus != ''">#{afterSaleStatus},</if>
            <if test="placedAt != null">#{placedAt},</if>
            <if test="paidAt != null">#{paidAt},</if>
            <if test="cancelledAt != null">#{cancelledAt},</if>
            <if test="completedAt != null">#{completedAt},</if>
            sysdate()
        )
    </insert>

    <update id="updateOrders" parameterType="Orders">
        update orders
        <set>
            <if test="orderNo != null and orderNo != ''">order_no = #{orderNo},</if>
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="channelCode != null and channelCode != ''">channel_code = #{channelCode},</if>
            <if test="externalOrderId != null">external_order_id = #{externalOrderId},</if>
            <if test="countryCode != null and countryCode != ''">country_code = #{countryCode},</if>
            <if test="currencyCode != null and currencyCode != ''">currency_code = #{currencyCode},</if>
            <if test="subtotalAmount != null">subtotal_amount = #{subtotalAmount},</if>
            <if test="discountAmount != null">discount_amount = #{discountAmount},</if>
            <if test="shippingAmount != null">shipping_amount = #{shippingAmount},</if>
            <if test="taxAmount != null">tax_amount = #{taxAmount},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="orderStatus != null and orderStatus != ''">order_status = #{orderStatus},</if>
            <if test="paymentStatus != null and paymentStatus != ''">payment_status = #{paymentStatus},</if>
            <if test="fulfillmentStatus != null and fulfillmentStatus != ''">fulfillment_status = #{fulfillmentStatus},</if>
            <if test="afterSaleStatus != null and afterSaleStatus != ''">after_sale_status = #{afterSaleStatus},</if>
            <if test="placedAt != null">placed_at = #{placedAt},</if>
            <if test="paidAt != null">paid_at = #{paidAt},</if>
            <if test="cancelledAt != null">cancelled_at = #{cancelledAt},</if>
            <if test="completedAt != null">completed_at = #{completedAt},</if>
            updated_at = sysdate()
        </set>
        where order_id = #{orderId}
    </update>

    <update id="updateOrderStatus">
        update orders
        <set>
            <choose>
                <when test="statusType == 'ORDER'">order_status = #{toStatus},</when>
                <when test="statusType == 'PAYMENT'">payment_status = #{toStatus},</when>
                <when test="statusType == 'FULFILLMENT'">fulfillment_status = #{toStatus},</when>
                <when test="statusType == 'AFTER_SALE'">after_sale_status = #{toStatus},</when>
            </choose>
            <if test="paidAt != null">paid_at = #{paidAt},</if>
            <if test="cancelledAt != null">cancelled_at = #{cancelledAt},</if>
            <if test="completedAt != null">completed_at = #{completedAt},</if>
            updated_at = sysdate()
        </set>
        where order_id = #{orderId}
    </update>

    <delete id="deleteOrdersById" parameterType="Long">
        delete from orders where order_id = #{orderId}
    </delete>

    <delete id="deleteOrdersByIds" parameterType="Long">
        delete from orders where order_id in
        <foreach item="orderId" collection="array" open="(" separator="," close=")">
            #{orderId}
        </foreach>
    </delete>

</mapper>
